[Desktop Entry]
Name=Google Chrome
Icon=google-chrome
Exec=sh -c '"$HOME/.dotfiles/bin/chrome-open" "$@"' _ %U
Terminal=false
Type=Application
StartupNotify=true
NoDisplay=true
MimeType=x-scheme-handler/mailto;x-scheme-handler/unknown;x-scheme-handler/about;x-scheme-handler/https;x-scheme-handler/http;text/html;
