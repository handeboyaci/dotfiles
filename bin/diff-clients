#!/usr/bin/zsh
_EXCLUDE="\.pyc$|__pycache__"
_parse() {
  while (( $# )) 
  do
    if [[ $1 == *@ ]]
    then
      user=${1::-1}
    elif [[ $1 == :* ]]
    then
      snapshot=${1:1}
    else
      client=$1
    fi
    shift
  done

  if [[ -z $snapshot ]]
  then
    echo "/google/src/cloud/${user:-$USER}/${client:-$CITC_NAME}"
  else
    echo "/google/src/cloud/${user:-$USER}/${client:-$CITC_NAME}/.snapshot/${snapshot:-head}"
  fi
}

parse() {
  regex="([^@:]*@?)([^@:]*)(:?[^@:]*)" 
  [[ "$1" =~ $regex ]]
  _parse ${match[*]}
}

files() {
  find $1/.citc/modified/google3/ -type f -printf "%P\n" |grep -Pv $_EXCLUDE
}


if [[ $# -eq 1 ]]
then
  base=$(parse)
elif [[ $# -eq 2 ]]
then
  base=$(parse $1)
  shift
else
  exit 1
fi

test=$(parse $1)

typeset -U all_files
all_files=( $(files $base) $(files $test) )

for f in ${all_files[@]}
do
  if cmp -s $test/google3/$f $base/google3/$f
  then
    continue
  fi
  echo "#######################################################################"
  echo "  $f"
  echo "#######################################################################"
  nvim -d $base/google3/$f $test/google3/$f 
done
