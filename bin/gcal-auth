#!/usr/bin/env python3
"""Initial OAuth2 authorization helper for the statusbar Google Calendar module.

Reads OAuth client credentials from ~/.dotfiles/tmp/google_calendar.credentials.json,
runs a local loopback OAuth2 flow in the browser, and writes the resulting token JSON
to ~/.dotfiles/tmp/google_calendar.auth.token in the format expected by statusbar.
"""

import argparse
import http.server
import json
import os
from pathlib import Path
import sys
import urllib.parse
import urllib.request
import webbrowser

SCOPE = "https://www.googleapis.com/auth/calendar.readonly"
AUTH_URI = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URI = "https://oauth2.googleapis.com/token"


def load_client_secrets(path: Path) -> tuple[str, str]:
    with path.open("r", encoding="utf-8") as f:
        raw = json.load(f)
    block = raw.get("installed") or raw.get("web") or raw
    client_id = block.get("client_id")
    client_secret = block.get("client_secret")
    if not client_id or not client_secret:
        raise ValueError(f"Missing client_id or client_secret in {path}")
    return client_id, client_secret


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--credentials",
        type=Path,
        default=Path.home() / ".dotfiles/tmp/google_calendar.credentials.json",
        help="Path to OAuth2 client credentials JSON file",
    )
    parser.add_argument(
        "--token-out",
        type=Path,
        default=Path.home() / ".dotfiles/tmp/google_calendar.auth.token",
        help="Path to write the authorized token JSON file",
    )
    parser.add_argument(
        "--no-browser",
        action="store_true",
        help="Print the authorization URL without opening a browser automatically",
    )
    args = parser.parse_args()

    creds_path = args.credentials.expanduser()
    token_path = args.token_out.expanduser()

    if not creds_path.exists():
        print(f"Error: client credentials file not found: {creds_path}", file=sys.stderr)
        return 1

    client_id, client_secret = load_client_secrets(creds_path)
    auth_code: dict[str, str | None] = {"code": None, "error": None}

    class CallbackHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            params = urllib.parse.parse_qs(parsed.query)
            if "code" in params:
                auth_code["code"] = params["code"][0]
                body = b"Authentication successful. You may close this tab."
                self.send_response(200)
            else:
                auth_code["error"] = params.get("error", ["unknown_error"])[0]
                body = f"Authentication failed: {auth_code['error']}".encode("utf-8")
                self.send_response(400)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, format, *args):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), CallbackHandler)
    port = server.server_port
    redirect_uri = f"http://127.0.0.1:{port}"

    query = urllib.parse.urlencode(
        {
            "client_id": client_id,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": SCOPE,
            "access_type": "offline",
            "prompt": "consent",
        }
    )
    url = f"{AUTH_URI}?{query}"

    print(f"Opening browser for Google Calendar OAuth2 login:\n  {url}\n")
    if not args.no_browser:
        webbrowser.open(url)

    server.handle_request()
    server.server_close()

    if auth_code["error"] or not auth_code["code"]:
        print(f"Error: authorization failed ({auth_code['error']})", file=sys.stderr)
        return 1

    post_data = urllib.parse.urlencode(
        {
            "code": auth_code["code"],
            "client_id": client_id,
            "client_secret": client_secret,
            "redirect_uri": redirect_uri,
            "grant_type": "authorization_code",
        }
    ).encode("utf-8")

    req = urllib.request.Request(
        TOKEN_URI,
        data=post_data,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        token_resp = json.loads(resp.read().decode("utf-8"))

    token_data = {
        "access_token": token_resp["access_token"],
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": token_resp.get("refresh_token", ""),
        "token_uri": TOKEN_URI,
        "scopes": [SCOPE],
    }

    token_path.parent.mkdir(parents=True, exist_ok=True)
    with token_path.open("w", encoding="utf-8") as f:
        json.dump(token_data, f, indent=2)
    os.chmod(token_path, 0o600)

    print(f"Saved Google Calendar auth token to {token_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
