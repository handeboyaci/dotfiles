#!/bin/sh
set -eu

# Guard: Do not run on headless host session
[ -n "${SWAY_HEADLESS:-}" ] && exit 0

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/meet-stream"
PID_FILE="$STATE_DIR/pids"
CAM_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/meet-stream-cam"
MIC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/meet-stream-mic"

is_streaming() {
    [ -f "$PID_FILE" ] && [ -s "$PID_FILE" ] && kill -0 "$(head -n 1 "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

get_target_ip() {
    if nmcli -t -f active,ssid 2>/dev/null | grep -q 'connected to ev' || ping -c 1 -W 1 192.168.1.12 >/dev/null 2>&1; then
        echo "192.168.1.12"
    else
        echo "sncr.duckdns.org"
    fi
}

list_cameras() {
    for dev in /sys/class/video4linux/video*; do
        [ -d "$dev" ] || continue
        # Ignore metadata streams (index != 0)
        [ "$(cat "$dev/index" 2>/dev/null || echo 0)" = "0" ] || continue

        devname=$(basename "$dev")
        name=$(cat "$dev/name" 2>/dev/null || echo "Webcam")
        devpath="/dev/$devname"

        # Check for stable persistent by-id link
        by_id=""
        if [ -d /dev/v4l/by-id ]; then
            for link in /dev/v4l/by-id/*; do
                if [ -e "$link" ] && [ "$(realpath "$link" 2>/dev/null)" = "$devpath" ]; then
                    case "$link" in
                        *-video-index0) by_id="$link"; break ;;
                    esac
                fi
            done
        fi
        target="${by_id:-$devpath}"
        echo "$name ($devpath)|$target"
    done
}

list_microphones() {
    echo "Default Microphone (System Default)|default"
    pactl list sources 2>/dev/null | awk '
        /^Source #[0-9]+/ { name=""; desc="" }
        /^[[:space:]]*Name: / { name=$2 }
        /^[[:space:]]*Description: / {
            sub(/^[[:space:]]*Description: /, "")
            desc=$0
        }
        name != "" && desc != "" {
            if (name !~ /\.monitor$/) {
                print desc "|" name
            }
            name=""; desc=""
        }
    ' || true
}

start_audio_pipeline() {
    target_ip="$1"
    mic_dev="${2:-}"

    if [ -n "$mic_dev" ] && [ "$mic_dev" != "default" ]; then
        gst-launch-1.0 -q \
            pulsesrc device="$mic_dev" ! \
            audioconvert ! \
            audioresample ! \
            "audio/x-raw,rate=48000,channels=1" ! \
            opusenc bitrate=64000 frame-size=20 audio-type=voice ! \
            rtpopuspay pt=127 ! \
            udpsink host="$target_ip" port=46000 sync=false >"$STATE_DIR/audio.log" 2>&1 &
    else
        gst-launch-1.0 -q \
            pulsesrc ! \
            audioconvert ! \
            audioresample ! \
            "audio/x-raw,rate=48000,channels=1" ! \
            opusenc bitrate=64000 frame-size=20 audio-type=voice ! \
            rtpopuspay pt=127 ! \
            udpsink host="$target_ip" port=46000 sync=false >"$STATE_DIR/audio.log" 2>&1 &
    fi
    echo $!
}

start_video_pipeline() {
    target_ip="$1"
    cam_dev="$2"

    if gst-inspect-1.0 vah264enc >/dev/null 2>&1; then
        ENC="vah264enc ! h264parse"
    elif gst-inspect-1.0 vaapih264enc >/dev/null 2>&1; then
        ENC="vaapih264enc ! h264parse"
    else
        ENC="x264enc tune=zerolatency speed-preset=ultrafast key-int-max=30 bframes=0 byte-stream=true bitrate=2000 ! h264parse"
    fi

    gst-launch-1.0 -q \
        v4l2src device="$cam_dev" ! \
        videoconvert ! \
        $ENC ! \
        rtph264pay config-interval=1 pt=96 ! \
        udpsink host="$target_ip" port=46002 sync=false >"$STATE_DIR/video.log" 2>&1 &
    echo $!
}

stop_stream() {
    if [ -f "$PID_FILE" ]; then
        while read -r pid; do
            [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
        done < "$PID_FILE"
        rm -f "$PID_FILE"
    fi
    pkill -f "gst-launch-1.0.*(46000|46002)" 2>/dev/null || true
    notify-send -u low -a "Meet Stream" "Streaming Stopped" "Webcam and microphone forwarding disabled."
}

select_camera() {
    cams=$(list_cameras)
    if [ -z "$cams" ]; then
        notify-send -u critical -a "Meet Stream" "No Webcams Found" "No video capture devices detected."
        return 1
    fi

    labels=$(echo "$cams" | cut -d'|' -f1)
    if command -v rofi >/dev/null 2>&1; then
        selected_label=$(echo "$labels" | rofi -dmenu -p "Select Webcam" -matching fuzzy -no-levenshtein-sort)
    else
        echo "Select webcam:"
        echo "$labels"
        read -r selected_label
    fi
    [ -z "$selected_label" ] && return 0
    choice=$(echo "$cams" | grep -F "$selected_label|" | head -n 1)

    dev_target=$(echo "$choice" | cut -d'|' -f2)
    dev_label=$(echo "$choice" | cut -d'|' -f1)
    echo "$dev_target" > "$CAM_CONFIG"

    # If streaming is already running, hot-swap only the video pipeline
    if is_streaming; then
        target_ip=$(get_target_ip)
        pkill -f "gst-launch-1.0.*46002" 2>/dev/null || true
        new_vpid=$(start_video_pipeline "$target_ip" "$dev_target")
        audio_pid=$(head -n 1 "$PID_FILE" 2>/dev/null || echo "")
        echo "$audio_pid" > "$PID_FILE"
        echo "$new_vpid" >> "$PID_FILE"
        notify-send -u normal -a "Meet Stream" "Webcam Switched" "$dev_label"
    else
        notify-send -u normal -a "Meet Stream" "Webcam Selected" "$dev_label"
    fi
}

select_microphone() {
    mics=$(list_microphones)
    labels=$(echo "$mics" | cut -d'|' -f1)
    if command -v rofi >/dev/null 2>&1; then
        selected_label=$(echo "$labels" | rofi -dmenu -p "Select Microphone" -matching fuzzy -no-levenshtein-sort)
    else
        echo "Select microphone:"
        echo "$labels"
        read -r selected_label
    fi
    [ -z "$selected_label" ] && return 0
    choice=$(echo "$mics" | grep -F "$selected_label|" | head -n 1)

    dev_target=$(echo "$choice" | cut -d'|' -f2)
    dev_label=$(echo "$choice" | cut -d'|' -f1)
    echo "$dev_target" > "$MIC_CONFIG"

    # If streaming is already running, hot-swap only the audio pipeline
    if is_streaming; then
        target_ip=$(get_target_ip)
        pkill -f "gst-launch-1.0.*46000" 2>/dev/null || true
        new_apid=$(start_audio_pipeline "$target_ip" "$dev_target")
        video_pid=$(sed -n '2p' "$PID_FILE" 2>/dev/null || echo "")
        echo "$new_apid" > "$PID_FILE"
        if [ -n "$video_pid" ]; then
            echo "$video_pid" >> "$PID_FILE"
        fi
        notify-send -u normal -a "Meet Stream" "Microphone Switched" "$dev_label"
    else
        notify-send -u normal -a "Meet Stream" "Microphone Selected" "$dev_label"
    fi
}

select_menu() {
    menu="📷 Select Webcam\n🎤 Select Microphone"
    if command -v rofi >/dev/null 2>&1; then
        chosen=$(printf "%b" "$menu" | rofi -dmenu -p "Meet Stream Devices" -matching fuzzy -no-levenshtein-sort)
    else
        echo "Meet Stream Devices:"
        printf "%b\n" "$menu"
        read -r chosen
    fi

    case "$chosen" in
        *"Webcam"*) select_camera ;;
        *"Microphone"*) select_microphone ;;
    esac
}

start_stream() {
    mkdir -p "$STATE_DIR"
    TARGET_IP=$(get_target_ip)

    # 1. Determine Camera Device
    CAM_DEV=""
    if [ -f "$CAM_CONFIG" ]; then
        saved_dev=$(cat "$CAM_CONFIG" 2>/dev/null || true)
        if [ -n "$saved_dev" ] && [ -e "$saved_dev" ]; then
            CAM_DEV="$saved_dev"
        fi
    fi

    if [ -z "$CAM_DEV" ]; then
        cams=$(list_cameras)
        count=$(echo "$cams" | grep -c '|' || true)
        if [ "$count" -gt 1 ]; then
            select_camera
            CAM_DEV=$(cat "$CAM_CONFIG" 2>/dev/null || true)
        elif [ "$count" -eq 1 ]; then
            CAM_DEV=$(echo "$cams" | cut -d'|' -f2)
            echo "$CAM_DEV" > "$CAM_CONFIG"
        fi
    fi

    # 2. Determine Microphone Device
    MIC_DEV="default"
    if [ -f "$MIC_CONFIG" ]; then
        saved_mic=$(cat "$MIC_CONFIG" 2>/dev/null || true)
        if [ -n "$saved_mic" ]; then
            MIC_DEV="$saved_mic"
        fi
    fi

    # 3. Start Audio Stream
    AUDIO_PID=$(start_audio_pipeline "$TARGET_IP" "$MIC_DEV")

    # 4. Start Video Stream if camera available
    VIDEO_PID=""
    if [ -n "$CAM_DEV" ] && [ -e "$CAM_DEV" ]; then
        VIDEO_PID=$(start_video_pipeline "$TARGET_IP" "$CAM_DEV")
        cam_name=$(cat "/sys/class/video4linux/$(basename "$(realpath "$CAM_DEV")")/name" 2>/dev/null || echo "$CAM_DEV")
        notify-send -u normal -a "Meet Stream" "Streaming Active" "Mic & Cam ($cam_name) -> $TARGET_IP"
    else
        notify-send -u normal -a "Meet Stream" "Audio Only Active" "Forwarding mic to $TARGET_IP (no camera)"
    fi

    # 5. Save PIDs
    echo "$AUDIO_PID" > "$PID_FILE"
    if [ -n "$VIDEO_PID" ]; then
        echo "$VIDEO_PID" >> "$PID_FILE"
    fi
}

# Command Line Dispatch
case "${1:-}" in
    --select|select)
        select_menu
        exit 0
        ;;
    --select-cam|select-cam)
        select_camera
        exit 0
        ;;
    --select-mic|select-mic)
        select_microphone
        exit 0
        ;;
    --help|-h)
        echo "Usage: meet-stream [options]"
        echo "  (no args)       Toggle microphone and webcam streaming"
        echo "  --select        Show menu to select webcam or microphone"
        echo "  --select-cam    Directly select webcam via rofi"
        echo "  --select-mic    Directly select microphone via rofi"
        exit 0
        ;;
esac

# Toggle logic
if is_streaming; then
    stop_stream
else
    start_stream
fi
