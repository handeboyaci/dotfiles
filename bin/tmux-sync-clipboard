#!/bin/bash
for client in $(tmux list-clients -F '#{client_tty}')
do
  tmux refresh-client -t $client -l
done

if [[ -d /tmp/$USER ]]; then
  for socket in $(find /tmp/$USER -maxdepth 1 -type s 2>/dev/null); do
    if ssh -o ConnectTimeout=2 -o BatchMode=yes -S "$socket" -O check dummy &>/dev/null; then
      ssh -o ConnectTimeout=2 -o BatchMode=yes -S "$socket" dummy \
        'for client in $(tmux list-clients -F "#{client_tty}" 2>/dev/null); do tmux refresh-client -t $client -l; done' &>/dev/null &
    fi
  done
  wait
fi
