	name = Sencer Selcuk
	email = sencerselcuk@gmail.com
[difftool]
	prompt = true
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[merge]
	tool = nvimdiff
	conflictstyle = diff3
[alias]
	d = difftool
	m = mergetool
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[include]
	path = ~/.gitconfig.local
