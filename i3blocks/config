full_text=|
align=center
color=#999999
separator=false
separator_block_width=15

[namaz]
full_text=Namaz
command=$HOME/.dotfiles/bin/namaz i3blocks
interval=60
color=#FFFFFF
[separator]

[calendar]
command=$HOME/.config/i3blocks/cal
interval=3600
color=#FFFFFF

[clock]
command=date +%H:%M
interval=30
color=#FFFFFF
[separator]

[doviz]
command=$HOME/.config/i3blocks/doviz
interval=300
color=#FFFFFF
[separator]

[weather]
command=curl -s wttr.in/?0mTQ|cut -c16-|head -2|command sed 's/\.\.+\?/ - /'|xargs
interval=3600
color=#FFFFFF
[separator]

