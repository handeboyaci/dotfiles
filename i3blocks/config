full_text=|
align=center
color=#999999
separator=false
separator_block_width=15

[namaz]
full_text=Namaz
command=$HOME/.dotfiles/bin/namaz i3blocks
interval=60
color=#FFFFFF
[separator]

[calendar]
command=$HOME/.config/i3blocks/cal
interval=3600
color=#FFFFFF

[clock]
command=date +%H:%M
interval=30
color=#FFFFFF
[separator]

[doviz]
command=$HOME/.config/i3blocks/doviz
interval=300
color=#FFFFFF
[separator]

[weather]
command=curl -Ss 'https://wttr.in?0&T&Q' | cut -c 16- | head -2 | xargs echo
interval=3600
color=#A4C2F4
[separator]

[vol]
full_text=Volume
command=$HOME/.config/i3blocks/vol
interval=once
color=#FFFFFF
signal=2
[separator]

[kb]
command=$HOME/.config/i3blocks/layout
interval=once
signal=1
color=#FFFFFF
[separator]

[shutdown]
full_text=⏻
command=$HOME/.config/i3blocks/shutdown
color=#FFFFFF
[separator]
