full_text=|
align=center
color=#999999
separator=false
separator_block_width=15

[namaz]
full_text=Namaz
command=$HOME/.dotfiles/bin/namaz i3blocks
interval=60
color=#FFFFFF
[separator]

[calendar]
command=$HOME/.config/i3blocks/cal
interval=3600
color=#FFFFFF

[clock]
command=date +%H:%M
interval=30
color=#FFFFFF
[separator]

[doviz]
command=$HOME/.config/i3blocks/doviz
interval=300
color=#FFFFFF
[separator]

[weather]
command=curl -s wttr.in/?0FnqTQ|cut -c16-|head -2|command sed 's/\.\.+\?/ - /'|xargs
interval=3600
color=#FFFFFF
[separator]

[vol]
full_text=Volume
command=$HOME/.config/i3blocks/volume
interval=once
color=#FFFFFF
signal=2
[separator]

[Brightness]
full_text=Brightness
command=$HOME/.config/i3blocks/screenlight
interval=once
color=#FFFFFF
signal=3
[separator]

[kb]
command=$HOME/.config/i3blocks/layout
interval=once
signal=1
color=#FFFFFF
[separator]

[power]
command=$HOME/.config/i3blocks/battery
interval=60
[separator]

[shutdown]
full_text=⏻
command=$HOME/.config/i3blocks/shutdown
color=#FFFFFF
[separator]
