#!/bin/bash
opts=(-dmenu -i -font "Fira Mono 30" -lines 0)

name=$(echo ''|rofi "${opts[@]}" -p "New workspace name " )

if [[ -n "$name" ]]
then
  num=$(swaymsg -t get_workspaces 2>/dev/null | jq -r '.[] | select(.visible and .focused) | .num')
  if [[ -n "$num" ]]; then
    swaymsg rename workspace to "\"${num}:${name}\""
  else
    swaymsg rename workspace to "\"${name}\""
  fi
fi
