configuration {
  font: "FantasqueSansMono Nerd Font 24";
  show-icons: false;
  icon-theme: "Papirus";
  drun-display-format : "{name}";
  disable-history: false;
  fullscreen: true;
  hide-scrollbar: true;
  sidebar-mode: false;
}

*  {
  background:  #25344BF0;
  background-alt:  #25344B00;
  foreground:  #FEFFF1;
  border:  #A162F7;
  border-alt:  #45E3FF;
  selected:  #6F88FE;
  urgent:  #DA4453;
  transparency: "real";
  background-color: @background-alt;
  text-color: @foreground;
}

#window {
  background-color: @background;
}

#dummy {
  expand: true;
  padding: 0;
  margins: 0;
}


#horibox {
  orientation: horizontal;
}

#listview {
  spacing: 10px;
  cycle: true;
  layout: horizontal;
  dynamic: false;
}

#element {
  border-radius: 100%;
  padding: 0px 0px 0px -5px;
}

#element-text {
  font: "feather 48";
  horizontal-align: 0.5;
  vertical-align: 0.5;
  margin: 60px 60px 100px 65px;
}

#element.selected {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-radius: 100%;
  border-color: @border;
}
