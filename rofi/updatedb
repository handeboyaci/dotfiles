#!/bin/bash

sudo updatedb
HOME=${HOME:-/home/sselcuk}

filter () {
  awk '{ print length, $0 }' | sort -n -s | cut -d' ' -f2-|cut -c$((${#HOME}+2))-
}

if [[ -s $HOME/.dotfiles/rofi/locate_ignore ]]; then
  locate $HOME | command grep -F -v -f <(command grep -v '^[[:space:]]*$' $HOME/.dotfiles/rofi/locate_ignore)
else
  locate $HOME
fi | filter > $HOME/.cache/rofi_file_db

