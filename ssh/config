Match host *.corp.google.com,*.c.googlers.com,cloud,ofis exec "! ([ -f /proc/$PPID/cmdline ] && tr '\0' '\n' < /proc/$PPID/cmdline | grep -q '^-O') && (gcertstatus --check_remaining=1h --quiet || gcert --disable_svelte)"
Match host ev exec "nmcli -t -f active,ssid|grep -q '^yes:ev$'"
  Hostname 192.168.1.12
Host ev
  Hostname sncr.duckdns.org
  IdentityFile ~/.ssh/id_ev
Host cloud
  Hostname sselcuk.c.googlers.com
  ProxyCommand corp-ssh-helper %h %p
  ForwardX11 yes
  ForwardX11Trusted yes
Host ofis
  Hostname sselcuk3.nyc.corp.google.com
  ProxyCommand corp-ssh-helper %h %p
  ForwardX11 no
  ForwardX11Trusted no
  Ciphers aes192-ctr,aes128-ctr
Host *
  Compression yes
  ControlMaster auto
  ControlPath /tmp/%u/%C
  ControlPersist yes
  IdentityFile ~/.ssh/id_github
  IdentityFile ~/.ssh/id_rsa

# vi: ft=sshconfig
