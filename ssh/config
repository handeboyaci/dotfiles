IgnoreUnknown UseKeychain
Match host ev exec "nmcli -t -f active,ssid 2>/dev/null|grep -q 'connected to ev'"
  Hostname 192.168.1.12
  Port 22
Match host hande exec "nmcli -t -f active,ssid 2>/dev/null|grep -q 'connected to ev'"
  ProxyJump none
Host ev
  User sselcuk
  Hostname sncr.duckdns.org
  Port 2233
  IdentityFile ~/.ssh/id_ev
Host hande
  Hostname 192.168.1.6
  User hande
  ProxyJump ev
  IdentityFile ~/.ssh/id_ev
Host *
  Compression yes
  ControlMaster auto
  ControlPath /tmp/%u/%C
  ControlPersist yes
  ServerAliveInterval 5
  ServerAliveCountMax 2
  IdentitiesOnly yes
  AddKeysToAgent 8h
  UseKeychain yes
  IdentityFile ~/.ssh/id_github
  IdentityFile ~/.ssh/id_rsa

# vi: ft=sshconfig
