Host ev
  Hostname 192.168.1.12
Host cloud
  Hostname sselcuk.c.googlers.com
  ProxyCommand  sh -c 'gcertstatus --nocheck_ssh --quiet || gcert --disable_svelte && corp-ssh-helper %h %p'
  ForwardX11 yes
  ForwardX11Trusted yes
Host ofis
  Hostname sselcuk3.nyc.corp.google.com
  ProxyCommand  sh -c 'gcertstatus --nocheck_ssh --quiet || gcert --disable_svelte && corp-ssh-helper %h %p'
  ForwardX11 no
  ForwardX11Trusted no
  Ciphers aes192-ctr,aes128-ctr
Host *
  Compression yes
  ControlMaster auto
  ControlPath /tmp/%u/%C
  ControlPersist yes
  IdentityFile ~/.ssh/id_github
  IdentityFile ~/.ssh/id_rsa
