Host cloud
  Hostname sselcuk.c.googlers.com
  ForwardX11 yes
  ForwardX11Trusted yes
Host ofis
  Hostname sselcuk3.nyc.corp.google.com
  ProxyCommand  corp-ssh-helper %h %p
  ForwardX11 no
  ForwardX11Trusted no
  Ciphers aes192-ctr,aes128-ctr
Host ev
  Hostname sencer.ddns.us
  IdentityFile ~/.ssh/id_rsa
  ForwardX11 yes
  ForwardX11Trusted yes
Host *.amazonaws.com
  User ubuntu
  IdentityFile ~/.ssh/sencer-aws.pem
Host *
  Compression yes
  ControlMaster auto
  ControlPath /tmp/%u/%C
  ControlPersist yes
  IdentityFile ~/.ssh/id_github
  IdentityFile ~/.ssh/id_rsa
