exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME

set $mod Mod4
set $alt Mod1

font pango:Fira Mono 12

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec --no-startup-id foot
bindsym $mod+Shift+Return exec --no-startup-id google-chrome

# kill focused window
bindsym $mod+w kill
bindsym $mod+Shift+w exec --no-startup-id nwg-bar

bindsym $mod+Shift+space exec --no-startup-id rofi -show run
bindsym $mod+space exec --no-startup-id rofi -modi drun -show drun -show-icons

bindsym $mod+p exec --no-startup-id rofi -modi pass:$HOME/.dotfiles/rofi/rofi-pass -show pass
bindsym $mod+b exec --no-startup-id rofi -modi locate:$HOME/.dotfiles/rofi/rofi-locate -show locate -matching fuzzy -sort -no-levenshtein-sort -columns 1

bindsym $mod+e exec --no-startup-id dbus-send --session --print-reply --dest=org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.ShowNotifications

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# scratchpad
bindsym $mod+m move scratchpad
bindsym $mod+Shift+m scratchpad show

# split in horizontal orientation
bindsym $mod+bar split h

# split in vertical orientation
bindsym $mod+minus split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+bracketright layout toggle split tabbed

# toggle tiling / floating
bindsym $mod+bracketleft floating toggle

# change focus between tiling / floating windows
bindsym $mod+Shift+bracketleft focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+d focus child

# make window sticky
bindsym $mod+s sticky toggle

bindsym Ctrl+$alt+Delete exec --no-startup-id swaylock 
bindswitch --locked lid:toggle exec swaylock && systemctl sleep
exec_always --no-startup-id swayidle


# screenshot
bindsym Print exec --no-startup-id grim -g "$(slurp)" - | wl-copy
bindsym shift+Print exec --no-startup-id grim -g "$(slurp)"

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
# switch to workspace
bindsym $mod+n exec --no-startup-id $HOME/.dotfiles/rofi/rofi-rename-workspace

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10:mail

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# move between monitors
bindsym $mod+Up move workspace to output up
bindsym $mod+Down move workspace to output down
bindsym $mod+Left move workspace to output left
bindsym $mod+Right move workspace to output right

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r reload

# resize window (you can also use the mouse for that)
mode "topleft" {
  bindsym h     resize grow   left 5 px or 5 ppt
  bindsym l     resize shrink left 5 px or 5 ppt
  bindsym Left  resize grow   left 5 px or 5 ppt
  bindsym Right resize shrink left 5 px or 5 ppt

  bindsym k    resize grow   up 5 px or 5 ppt
  bindsym j    resize shrink up 5 px or 5 ppt
  bindsym Up   resize grow   up 5 px or 5 ppt
  bindsym Down resize shrink up 5 px or 5 ppt

  bindsym space  mode "bottomright"
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

mode "bottomright" {
  bindsym l     resize grow   right 5 px or 5 ppt
  bindsym h     resize shrink right 5 px or 5 ppt
  bindsym Right resize grow   right 5 px or 5 ppt
  bindsym Left  resize shrink right 5 px or 5 ppt

  bindsym j    resize grow   down 5 px or 5 ppt
  bindsym k    resize shrink down 5 px or 5 ppt
  bindsym Down resize grow   down 5 px or 5 ppt
  bindsym Up   resize shrink down 5 px or 5 ppt

  bindsym space  mode "topleft"
  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}

bindsym $mod+r mode "topleft"

mode "move" {
    bindsym Tab focus right

    bindsym Left  move left
    bindsym Down  move down
    bindsym Up    move up
    bindsym Right move right

    bindsym h     move left
    bindsym j     move down
    bindsym k     move up
    bindsym l     move right

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+t mode "default"
}
bindsym $mod+t mode "move" focus floating

bindsym $mod+plus bar mode toggle
# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
    position top
    status_command py3status -c ~/.config/sway/py3status.config -i ~/.config/sway/py3status/

    tray_output primary
    tray_padding 3
    colors {
        background #4a3e35cc
        statusline #f5e4c6
        separator #7d6b5e

        focused_workspace    #d9a066 #6b5a4d #f5e4c6
        active_workspace     #6b5a4d #4a3e35 #f5e4c6
        inactive_workspace   #3a2f26 #2a201b #b2a090
        urgent_workspace     #cc6666 #cc6666 #f5e4c6
        binding_mode         #cc7755 #9e4733 #f5e4c6
    }
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    dwt enabled
    drag enabled
    drag_lock disabled
    click_method clickfinger
    clickfinger_button_map lrm
}

input * {
    xkb_layout "us,tr"
    xkb_options "caps:ctrl_modifier,grp:alt_space_toggle,misc:typo"
}


default_border pixel 2
default_floating_border pixel 2
hide_edge_borders --i3 smart
popup_during_fullscreen smart

gaps inner 3
gaps outer -3
smart_gaps on

for_window [class="^.*"] border pixel 2
for_window [class="gnome"] floating enable, resize set 50ppt 50ppt, move position center
for_window [app_id="org.gnome.Settings"] floating enable, resize set 50ppt 50ppt, move position center
for_window [app_id="wdisplays"] floating enable, resize set 50ppt 50ppt, move position center
for_window [class="gnuplot"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable, border pixel 0
for_window [instance="web.whatsapp.com|mail.google.com"] floating disable

client.unfocused        #4c4c4c   #4c4c4c   #4c4c4c   #4c4c4c
client.focused          #3eaeff   #3eaeff   #3eaeff   #3eaeff
client.focused_inactive #CC000066 #CC000066 #CC000066 #3eaeff66
client.urgent           #00FF00   #00FF00   #00ff00   #00FF00

focus_follows_mouse no
workspace_auto_back_and_forth yes

exec_always --no-startup-id $HOME/.local/bin/i3-notifier
exec_always --no-startup-id swaybg -i $HOME/.config/sway/bg.jpg
exec --no-startup-id systemctl --user restart kanshi.service
exec --no-startup-id systemctl --user restart swayosd-server.service
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise --max-volume=120
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower --max-volume=120
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower

exec --no-startup-id /usr/libexec/gsd-rfkill
