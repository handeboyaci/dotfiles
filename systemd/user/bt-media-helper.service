[Unit]
Description=Auto-pause, auto-resume, and Bluetooth profile helper
After=graphical-session.target mpris-proxy.service
Wants=mpris-proxy.service
PartOf=graphical-session.target
# Safe to enable on every machine: skipped (not failed) unless a binary is
# installed. Build with `make -C ~/.dotfiles/data bt-media-helper`.
ConditionFileIsExecutable=|%h/.dotfiles/data/bt-media-helper
ConditionFileIsExecutable=|%h/.local/bin/bt-media-helper
ConditionFileIsExecutable=|/usr/local/bin/bt-media-helper
ConditionFileIsExecutable=|/usr/bin/bt-media-helper

[Service]
Type=simple
ExecStart=/bin/sh -c 'for b in "$HOME/.dotfiles/data" "$HOME/.local/bin" /usr/local/bin /usr/bin; do [ -x "$b/bt-media-helper" ] && exec "$b/bt-media-helper"; done; exit 1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
