[Unit]
Description=Fullmoon Unified Host Daemon (Clipboard Sync + Media Receiver)
ConditionPathExists=%h/software/sunshine.AppImage
Requires=fullmoon.socket
After=fullmoon.socket sway-sunshine.service
PartOf=sway-sunshine.service

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-1
Environment=SWAYSOCK=%t/sway-sunshine.sock
ExecStart=%h/.dotfiles/data/fullmoon --serve
Restart=no
KillMode=control-group
TimeoutStopSec=3s
LimitCORE=0
MemoryMax=128M
