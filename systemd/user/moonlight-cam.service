[Unit]
Description=Moonlight Virtual Camera & Microphone On-Demand Receiver
ConditionPathExists=%h/software/sunshine.AppImage
Requires=moonlight-cam.socket
After=moonlight-cam.socket

[Service]
Type=simple
ExecStart=%h/.dotfiles/bin/meet-stream --serve
Restart=no
KillMode=control-group
TimeoutStopSec=3s
