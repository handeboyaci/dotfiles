[Unit]
Description=Moonlight Virtual Clipboard On-Demand Receiver
ConditionPathExists=%h/software/sunshine.AppImage
Requires=moonlight-clip.socket
After=moonlight-clip.socket sway-sunshine.service
PartOf=sway-sunshine.service

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-1
Environment=SWAYSOCK=%t/sway-sunshine.sock
ExecStart=%h/.dotfiles/data/clip-sync --serve
Restart=no
KillMode=control-group
TimeoutStopSec=3s
LimitCORE=0
MemoryMax=64M
