[Unit]
Description=myNoise Continuous Audio Streamer & Mixer
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sselcuk/projects/noise/
ExecStart=/usr/bin/python3 -u /home/sselcuk/projects/noise/server.py
Restart=always
RestartSec=5
Environment=PORT=8088
Environment=DATA_DIR=/home/sselcuk/projects/noise/data

[Install]
WantedBy=default.target
