[Unit]
Description=Start the Quiet notification service
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
BusName=org.freedesktop.Notifications
ExecStart=%h/.local/bin/quiet --nodaemon
Restart=always
RestartSec=3

[Install]
WantedBy=sway-session.target sway-headless-session.target default.target
