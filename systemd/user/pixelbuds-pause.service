[Unit]
Description=Auto-pause and auto-resume media on Pixel Buds / Bluetooth connection changes
After=graphical-session.target mpris-proxy.service
Wants=mpris-proxy.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'if [ -x "$HOME/.dotfiles/data/pixelbuds-pause" ]; then exec "$HOME/.dotfiles/data/pixelbuds-pause"; elif [ -x "$HOME/.local/bin/pixelbuds-pause" ]; then exec "$HOME/.local/bin/pixelbuds-pause"; else exec /usr/bin/pixelbuds-pause; fi'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sway-session.target
