[Unit]
Description=Headless Sway session for Sunshine streaming
Before=sway-session.target
Before=sway-headless-session.target
Wants=sway-headless-session.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-1
Environment=SWAY_HEADLESS=1
Environment=WLR_BACKENDS=headless,libinput
Environment=LIBSEAT_BACKEND=noop
Environment=WLR_RENDERER=gles2
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=SWAYSOCK=%t/sway-sunshine.sock
Environment=PULSE_SINK=sink-sunshine-stereo
ExecStartPre=-/bin/rm -f %t/sway-sunshine.sock
ExecStart=/usr/bin/sway --config %h/.config/sway/sunshine.conf
ExecStopPost=-/usr/bin/systemctl --user stop sunshine-headless.service
ExecStopPost=-/usr/bin/systemctl --user --no-block start sunshine-headless.socket
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=5s

[Install]
WantedBy=default.target
