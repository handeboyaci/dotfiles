[Unit]
Description=Start swaybg for headless Sway
After=sway-sunshine.service
BindsTo=sway-headless-session.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=%t
ExecStartPre=/bin/sh -c 'while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do sleep 0.1; done'
ExecStart=/usr/bin/swaybg -i %h/.config/sway/bg.jpg
Restart=on-failure
RestartSec=3

[Install]
WantedBy=sway-headless-session.target
