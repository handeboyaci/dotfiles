#!/usr/bin/env python3
"""Open public web URLs selected via tmux-thumbs."""

import subprocess
import sys


def main() -> int:
  opener = "open" if sys.platform == "darwin" else "xdg-open"
  tokens = [tok for arg in sys.argv[1:] for tok in arg.split()]
  for tok in tokens:
    if tok.startswith(("http://", "https://")):
      subprocess.Popen(
        [opener, tok],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
      )
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
