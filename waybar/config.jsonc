{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "modules-left": ["sway/workspaces", "sway/scratchpad"],
    "modules-center": ["clock"],
    "modules-right": [
        "quiet",
        "google_calendar",
        "mpris",
        "pulseaudio",
        "namaz",
        "battery",
        "screensaver",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/scratchpad": {
        "format": "⌫ {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}",
        "on-click": "swaymsg 'scratchpad show'"
    },

    "clock": {
        "interval": 60,
        "format": "{:%a %d/%b/%Y | %H:%M}",
        "format-alt": "{:%a %d/%b/%Y | %H:%M:%S}",
        "format-alt-click": 3,
        "timezones": ["America/New_York", "Europe/Zurich", "Asia/Istanbul"],
        "tooltip-format": "<tt>{tz_list}\n\n{calendar}</tt>",
        "timezone-tooltip-format": "{:%H:%M %Z}",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "iso8601": true,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#7d6b5e'>{}</span>",
                "today": "<span background='#ffead3' color='#4a3e35'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click": "tz_up"
        },
        "on-click-middle": "google-chrome --app=http://calendar.google.com/"
    },

    "quiet": {
        "format": "{}",
        "tooltip": true
    },

    "google_calendar": {
        "format": "{}",
        "tooltip": true
    },

    "mpris": {
        "format": "{status_icon}",
        "format-paused": "{status_icon}",
        "status-icons": {
            "playing": "⏸",
            "paused": "▶"
        },
        "tooltip-format": "{artist} - {title}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "🔇",
        "format-icons": {
            "default": ["🔈", "🔊"]
        },
        "states": {
            "zero": 0
        },
        "format-zero": "🔇",
        "scroll-step": 2,
        "max-volume": 150,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": true,
        "tooltip-format": "{volume}%"
    },

    "namaz": {
        "format": "{}",
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 15,
            "critical": 5
        },
        "format": "{icon}",
        "format-charging": "⚡",
        "format-plugged": "🔌",
        "format-icons": ["▁", "⡀", "⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣾", "⣿", "🔋"],
        "events": {
            "on-discharging-critical": "notify-send -u critical 'Low Battery' 'Battery is below 5%!'"
        },
        "tooltip-format": "{capacity}% ({time})"
    },

    "screensaver": {
        "format": "{}",
        "tooltip": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
