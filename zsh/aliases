alias clear!='clear&&printf "\e[3J"'
if ls --version >/dev/null 2>&1; then
  alias ls='ls --group-directories-first --color=auto'
  alias lx='ls -XB'
else
  export LSCOLORS="ExGxFxDxCxegedabagacad"
  alias ls='ls -G'
fi
alias la='ls -AF'
alias ll='ls -lhAF'
if cp --version >/dev/null 2>&1; then
  alias cp='cp -ivdRp'
else
  alias cp='cp -ivRpP'
fi
alias mv='mv -iv'
alias mkdir='mkdir -p'
if sed --version >/dev/null 2>&1; then
  alias sed='sed -r'
else
  alias sed='sed -E'
fi
if echo "" | grep -P '' >/dev/null 2>&1; then
  alias grep='grep -P --color=auto'
else
  alias grep='grep -E --color=auto'
fi
if rsync --help 2>&1 | grep -q -- '--info='; then
  alias scp='rsync -az --info=progress2 -e "ssh -q"'
else
  alias scp='rsync -az --progress -e "ssh -q"'
fi
alias rm='rm -i'
alias ln='ln -i'
alias type='type -a'
alias vimdiff='nvim -d'
alias bc='bc -lq'
alias units='units -1t'
alias octave='octave-cli -q'
alias julia='julia -q'
# Debian ships fd as `fdfind`, Homebrew as `fd`
if command -v fdfind >/dev/null 2>&1; then _fd=fdfind; else _fd=fd; fi
if [[ -z $BASH_VERSION ]]; then
  alias fd="noglob $_fd"
  alias notmuch='noglob notmuch'
  alias find='noglob find'
else
  [[ $_fd == fd ]] || alias fd="$_fd"
fi
unset _fd

alias dc='cd'
alias sl='ls'

alias v='nvim'
alias vi='nvim'
alias vm="v --cmd 'set rtp^=$HOME/.dotfiles/mail/notmuch-vim' +NotMuch"

alias plot="gnuplot"

alias hgrep="history 0|grep"
alias xgrep="xargs grep"
alias xsed="xargs sed"

for index in {1..20}; do
  alias "$index"="cd +${index}"
done
unset index
alias d='dirs -v'
alias stop='ssh -O stop'

