#compdef g4
typeset -A opt_args
autoload -Uz _g4_generated_completion

# Load autogenerated completion.
_g4_generated_completion

_g4() {
  _arguments -C '*::command:->subcommands' && return 0
  if (( CURRENT == 1 )); then
    _g4_describe_commands
  else
    _g4_command_completion "$words[1]"
  fi
}

_g4_describe_cls() {
  local curcontext="$curcontext"
  _cls=("${(@f)$(_call_program changelists g4 pending -s fullpath | awk '/^(\* |)Change/ { gsub(".*Change ", "", $0); sub(" :", ":", $0); print $0}')}")
  _describe -t changelist 'changelist' _cls
}

_g4_describe_citc_clients() {
  local curcontext="$curcontext"
  _citc_clients=("${(@f)$(_call_program citc_clients g4 clients -u ${USER} | awk ' /.*:citc/ { split($2, a, ":"); print a[2]; }')}")
  _describe -t citc_clients 'citc clients' _citc_clients
}

_g4 "$@"
