# vi: ft=zsh
#
function usage {
  cat << EOF
  ras [-d] [-e] [-t] [-s server] command
  -d         dry run
  -e         do not escape special chars
  -t         run ssh as ssh -t (with a terminal)
  -s server  specify a server manually
  -i         run local command if no server is found [doesn't make sense with -s]
  -h -help   this screen
EOF
}

if [[ $# -eq 0 ]]
then
  usage
  return 1
fi

zparseopts -D -- d=dry i=onlyif e=noescape t=term s:=host h=help -help=help

if [[ -n $help  ]]
then
  usage
  return 1
fi

if (( $+term[1] ))
then
  term='-t'
fi

if (( $+noescape[1] ))
then
  cmd="${@}"
else
  cmd="${(@qqq)@}"
fi

if (( $+host[2] ))
then
  PROD_PROXY=$host[2]
fi

if [[ -n $PROD_PROXY ]]
then
  server=$PROD_PROXY

  if [[ -n $CITC_NAME ]]
  then
    cmd="cd $CITC_ROOT/$CITC_PWD; $cmd"
  else
    cmd="$cmd"
  fi
else
  if (( $+onlyif[1] ))
  then
    eval "${(Q)cmd}"
  else
    echo "No remote server specified."
  fi
  return 1
fi

if [[ $# -lt 1  ]]
then
  usage
  return 1
fi

if (( $+dry[1] ))
then
  echo ssh -q $term $server "\"$cmd\""
else
  ssh -q $term $server "$cmd"
fi
