# clipboard integration {{{
if [[ -n $TMUX ]]
then
  function cutbuffer() {
    zle .$WIDGET
    printf "\033]52;c;$(printf "%s" "$CUTBUFFER" | base64 | tr -d '\n')\a"
  }

  function putbuffer() {
    zle copy-region-as-kill "$(tmux save-buffer -)"
    zle .$WIDGET
  }
elif [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-copy] ))
then
  function cutbuffer() {
    zle .$WIDGET
    printf "%s" "$CUTBUFFER" | wl-copy
  }

  function putbuffer() {
    zle copy-region-as-kill "$(wl-paste -n)"
    zle .$WIDGET
  }
fi

(( $+functions[cutbuffer] )) && {
  zle_cut_widgets=( vi-backward-delete-char vi-change vi-change-eol
  vi-change-whole-line vi-delete vi-delete-char vi-kill-eol vi-substitute
  vi-yank vi-yank-eol kill-word backward-kill-word vi-backward-kill-word
  vi-kill-line )

  for widget in $zle_cut_widgets; do
    zle -N $widget cutbuffer
  done


  zle_put_widgets=( vi-put-after vi-put-before )
  for widget in $zle_put_widgets; do
    zle -N $widget putbuffer
  done
}
