# Auto-compile large zsh scripts in the background
function _auto_zcompile() {
  local files=(
    "$ZDOTDIR/zshrc"
    "$ZDOTDIR/syntax-highlight/fast-syntax-highlighting.plugin.zsh"
    "$ZDOTDIR/syntax-highlight/fast-highlight"
    "$ZDOTDIR/g4d/async.zsh"
    "$ZDOTDIR/autoload/_blaze"
    "$ZDOTDIR/autoload/_g4_generated_completion"
  )
  local f
  for f in $files; do
    if [[ -s "$f" && (! -s "${f}.zwc" || "$f" -nt "${f}.zwc") ]]; then
      zcompile "$f"
    fi
  done
}
{ _auto_zcompile } &!
