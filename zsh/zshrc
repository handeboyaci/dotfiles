# prepend sudo {{{
function prepend-sudo {
  if [[ "$BUFFER" != su(do|)\ * ]]; then
    if [[ "$BUFFER" == "v "* ]]; then
      BUFFER="sudoedit ${BUFFER#v }"
      (( CURSOR += 8 ))
    else
      BUFFER="sudo $BUFFER"
      (( CURSOR += 5 ))
    fi
  fi
}
zle -N prepend-sudo
bindkey -M viins "\C-s" prepend-sudo
